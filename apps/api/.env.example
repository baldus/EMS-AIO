# EMS API — local development values only. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL="postgresql://ems:ems_local_dev_only@localhost:5432/ems_dev?schema=public"

# Comma-separated browser origins allowed by CORS (the web app calls the API server-side, so
# this is only needed for tools like the Swagger UI on another origin).
CORS_ORIGINS=http://localhost:3000

# OIDC resource server settings (Keycloak dev realm from infra/docker-compose.yml).
OIDC_ISSUER_URL=http://localhost:8080/realms/ems
OIDC_AUDIENCE=ems-api
# Optional: overrides JWKS discovery via the issuer's /.well-known/openid-configuration.
# OIDC_JWKS_URI=http://localhost:8080/realms/ems/protocol/openid-connect/certs

# A session satisfies MFA when the token's `amr` claim contains one of these values,
# or its `acr` claim equals one of AUTH_MFA_ACR_VALUES.
AUTH_MFA_AMR_VALUES=mfa,otp,totp,hwk,swk,webauthn
AUTH_MFA_ACR_VALUES=
# Link a pre-provisioned (invited) user to an OIDC subject by verified email on first login.
AUTH_EMAIL_LINKING_ENABLED=true

API_DOCS_ENABLED=true
