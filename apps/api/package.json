{
  "name": "@ems/api",
  "version": "0.1.0",
  "private": true,
  "description": "EMS platform API (NestJS modular monolith).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "openapi:generate": "pnpm build && node dist/openapi/generate.js"
  },
  "dependencies": {
    "@ems/db": "workspace:*",
    "@ems/domain": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@swc/core": "1.13.21",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
