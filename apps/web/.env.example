# EMS web — local development values only. Never commit real secrets.
# Public URL of this web app (used for OIDC redirect URIs and origin checks).
APP_URL=http://localhost:3000
# Base URL the Next.js server uses to call the API.
API_BASE_URL=http://localhost:4000

# OIDC client (Keycloak dev realm from infra/docker-compose.yml).
OIDC_ISSUER_URL=http://localhost:8080/realms/ems
OIDC_CLIENT_ID=ems-web
# Local-only secret matching infra/keycloak/ems-realm.json. Use a secrets manager elsewhere.
OIDC_CLIENT_SECRET=ems-web-local-dev-only-secret
OIDC_SCOPES=openid profile email

# 32+ random characters used to encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32-plus-random-characters-for-local-dev
