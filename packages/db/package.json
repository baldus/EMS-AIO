{
  "name": "@ems/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, client, and fictional seed data for the EMS platform.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "reset": "prisma migrate reset --force --skip-seed && pnpm seed",
    "seed": "tsx src/seed.ts",
    "validate": "prisma validate && prisma format --check"
  },
  "dependencies": {
    "@ems/domain": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
