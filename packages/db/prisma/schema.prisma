// EMS platform data model.
//
// Conventions (see docs/architecture/data-model.md):
// - Tables/columns are snake_case; Prisma models/fields are PascalCase/camelCase.
// - Primary keys are UUIDs generated in PostgreSQL (gen_random_uuid()).
// - All timestamps are timestamptz (UTC). Calendar dates use `date`.
// - Money is integer minor units (cents) in BIGINT with an ISO-4217 currency code.
// - Mutable business records carry `version` for optimistic concurrency.
// - Append-only tables (audit_events, approvals, document_revisions) and approved baselines are
//   protected by database triggers defined in migration 0002_integrity_guards.
// - Constraints Prisma cannot express (CHECKs, partial unique indexes, triggers) live in raw SQL
//   migrations and are documented beside the model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

