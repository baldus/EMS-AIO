  "info": {
    "title": "EMS Platform API",
    "description": "API for the EMS industrial project management platform. All errors are RFC 9457 problem details (application/problem+json). Authenticate with an OIDC access token.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "RoleGrantDto": {
        "type": "object",
        "properties": {
          "roleKey": {
            "type": "string"
          },
          "scopeType": {
            "type": "string",
            "enum": [
              "global",
              "organization",
              "project"
            ]
          },
          "organizationId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "mfaRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "roleKey",
          "scopeType",
          "organizationId",
          "projectId",
          "mfaRequired"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "userType": {
            "type": "string",
            "enum": [
              "internal",
              "customer",
              "service"
            ]
          },
          "homeOrganizationId": {
            "type": "string",
            "format": "uuid"
          },
          "homeOrganizationName": {
            "type": "string"
          },
          "mfaSatisfied": {
            "type": "boolean",
            "description": "Whether the current session satisfied MFA"
          },
          "permissions": {
            "description": "Permissions effective in at least one scope",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrantDto"
            }
          }
        },
        "required": [
          "userId",
          "email",
          "displayName",
          "userType",
          "homeOrganizationId",
          "homeOrganizationName",
          "mfaSatisfied",
          "permissions",
          "grants"
        ]
      },
      "KindCountDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "count"
        ]
      },
      "RecentActivityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "nullable": true
          },
          "actorDisplayName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "occurredAt",
          "action",
          "entityType",
          "entityId",
          "actorDisplayName"
        ]
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "organizationsByKind": {
            "description": "Non-archived organizations by kind",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindCountDto"
            }
          },
          "activeProjects": {
            "type": "number"
          },
          "activeEngagements": {
            "type": "number"
          },
          "recentActivity": {
            "description": "Empty unless the caller may read audit history",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentActivityDto"
            }
          }
        },
        "required": [
          "organizationsByKind",
          "activeProjects",
          "activeEngagements",
          "recentActivity"
        ]
      },
      "ProblemFieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldErrorDto"
            }
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "instance"
        ]
      },
      "OrganizationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "legalName": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "ems_operator",
              "customer",
              "prospect",
              "partner",
              "vendor"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "archived"
            ]
          },
          "segment": {
            "type": "string",
            "enum": [
              "manufacturer",
              "custom_machine_builder",
